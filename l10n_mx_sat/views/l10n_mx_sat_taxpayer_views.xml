<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_mx_sat_taxpayer_view_list" model="ir.ui.view">
        <field name="name">l10n_mx_sat.taxpayer.list</field>
        <field name="model">l10n_mx_sat.taxpayer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="rfc" />
                <field name="fiel_configured" />
                <field name="auto_download" />
                <field name="last_sync" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="l10n_mx_sat_taxpayer_view_form" model="ir.ui.view">
        <field name="name">l10n_mx_sat.taxpayer.form</field>
        <field name="model">l10n_mx_sat.taxpayer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_open_fiel_wizard"
                        type="object"
                        string="Cargar credenciales FIEL"
                        class="btn-secondary"
                        icon="fa-key"
                        invisible="not id"
                    />
                    <button
                        name="action_test_connection"
                        type="object"
                        string="Probar conexión"
                        class="btn-secondary"
                        icon="fa-plug"
                        invisible="not fiel_configured"
                    />
                    <button
                        name="action_sync_now"
                        type="object"
                        string="Sincronizar ahora"
                        class="btn-primary"
                        icon="fa-refresh"
                        invisible="not fiel_configured"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_view_documents"
                            icon="fa-file-text-o"
                        >
                            <field
                                name="document_count"
                                widget="statinfo"
                                string="Documentos SAT"
                            />
                        </button>
                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_view_download_requests"
                            icon="fa-cloud-download"
                        >
                            <field
                                name="download_request_count"
                                widget="statinfo"
                                string="Solicitudes de descarga"
                            />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archivado"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <field name="active" invisible="1" />
                    <div class="oe_title">
                        <label for="name" string="Razón social" />
                        <h1>
                            <field name="name" placeholder="Razón social" />
                        </h1>
                    </div>
                    <group>
                        <group string="Identificación" name="identification">
                            <field name="rfc" placeholder="Se llena al cargar la FIEL" />
                            <field name="fiel_configured" />
                            <field
                                name="fiel_certificate_configured"
                                invisible="fiel_configured"
                            />
                            <field
                                name="fiel_key_configured"
                                invisible="fiel_configured"
                            />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                        <group string="Sincronización" name="synchronization">
                            <field name="auto_download" />
                            <field name="sync_from" />
                            <field name="metadata_sync_from" />
                            <field name="last_sync" />
                            <field name="last_metadata_sync" />
                        </group>
                    </group>
                    <group string="Tipos de descarga" name="download_types">
                        <group>
                            <field name="download_cfdi_issued" />
                            <field name="download_cfdi_received" />
                        </group>
                        <group>
                            <field name="download_retention_issued" />
                            <field name="download_retention_received" />
                        </group>
                    </group>
                    <div
                        class="alert alert-info"
                        role="alert"
                        invisible="fiel_configured"
                    >
                        Sube el certificado FIEL, la llave privada y la contraseña
                        para habilitar las descargas del SAT de esta razón social.
                        El RFC se lee del certificado.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_mx_sat_taxpayer_view_search" model="ir.ui.view">
        <field name="name">l10n_mx_sat.taxpayer.search</field>
        <field name="model">l10n_mx_sat.taxpayer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="rfc" />
                <filter
                    string="Descarga automática"
                    name="auto_download"
                    domain="[('auto_download', '=', True)]"
                />
                <filter
                    string="Archivadas"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
                <group>
                    <filter
                        string="Compañía"
                        name="group_company"
                        context="{'group_by': 'company_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="l10n_mx_sat_taxpayer_action" model="ir.actions.act_window">
        <field name="name">Razones sociales</field>
        <field name="res_model">l10n_mx_sat.taxpayer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="l10n_mx_sat_taxpayer_view_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registra una razón social
            </p>
            <p>
                Cada razón social guarda sus propias credenciales FIEL y
                descarga CFDIs del SAT de forma independiente, sin necesidad
                de crear una compañía adicional en Odoo.
            </p>
        </field>
    </record>
</odoo>
