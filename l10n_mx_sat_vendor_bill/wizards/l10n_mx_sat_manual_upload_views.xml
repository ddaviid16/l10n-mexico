<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_mx_sat_manual_upload_view_form" model="ir.ui.view">
        <field name="name">l10n_mx_sat.manual.upload.form</field>
        <field name="model">l10n_mx_sat.manual.upload</field>
        <field name="arch" type="xml">
            <form string="Carga manual de CFDI">
                <div class="alert alert-info" role="status">
                    Sube el ZIP tal como lo recibiste. Cada XML se asigna a su
                    razón social por el RFC del receptor, se crea el documento
                    en Conexión SAT y su borrador de factura, y se intenta el
                    cotejo con una orden de compra que coincida.
                    <br />
                    Si un CFDI ya se había importado, se actualiza: no se crea
                    un segundo borrador.
                </div>
                <group>
                    <field
                        name="zip_file"
                        filename="zip_filename"
                        widget="binary"
                    />
                    <field name="zip_filename" invisible="1" />
                </group>
                <footer>
                    <button
                        name="action_import"
                        type="object"
                        string="Importar"
                        class="btn-primary"
                    />
                    <button
                        string="Cancelar"
                        class="btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <!-- No menuitem on purpose: the menu lives in Accounting, under Vendors,
         and is assigned separately. This action is what it points at. -->
    <record id="l10n_mx_sat_manual_upload_action" model="ir.actions.act_window">
        <field name="name">Cargar CFDI de proveedor (.zip)</field>
        <field name="res_model">l10n_mx_sat.manual.upload</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
